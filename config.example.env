# =============================================================================
# MCP-server för discovery — sök publikationer och deras metadata
# Konfigurationsmall — kopiera till .env och fyll i värden
# .env ska aldrig checkas in i git
# =============================================================================

# -----------------------------------------------------------------------------
# Libris-API (KB:s nationella bibliotekskatalog)
# -----------------------------------------------------------------------------
# Bas-URL för Libris sök- och läs-API. Behöver normalt inte ändras.
LIBRIS_BASE_URL=https://libris.kb.se

# Bas-URL för id.kb.se — KB:s länkade auktoritetsdata (ämnen, personer, språk).
# Används av termuppslaget. Behöver normalt inte ändras.
LIBRIS_ID_BASE_URL=https://id.kb.se

# User-Agent. Libris uppmanar uttryckligen anropare att identifiera sig så att
# KB kan kontakta dig vid problem. Sätt en egen med kontaktuppgift.
LIBRIS_USER_AGENT=Discovery-MCP/0.1 (+https://github.com/<GITHUB_KONTO>/discovery-mcp)

# Timeout i sekunder för HTTP-anrop mot Libris.
LIBRIS_TIMEOUT=30

# -----------------------------------------------------------------------------
# Crossref-API (DOI:er för artiklar, böcker, konferensbidrag)
# -----------------------------------------------------------------------------
# Bas-URL för Crossref REST-API. Behöver normalt inte ändras.
CROSSREF_BASE_URL=https://api.crossref.org

# Kontakt-e-post som lägger anropen i Crossrefs "polite pool" med bättre
# svarstider. Frivilligt men rekommenderas. Lämna tom för anonyma anrop.
CROSSREF_MAILTO=

# User-Agent för Crossref. Kontakt-e-posten ovan bakas in automatiskt.
CROSSREF_USER_AGENT=Discovery-MCP/0.1 (+https://github.com/<GITHUB_KONTO>/discovery-mcp)

# Timeout i sekunder för HTTP-anrop mot Crossref.
CROSSREF_TIMEOUT=30

# -----------------------------------------------------------------------------
# DataCite-API (DOI:er för forskningsdata, programvara, preprints)
# -----------------------------------------------------------------------------
# Bas-URL för DataCite REST-API. Behöver normalt inte ändras.
DATACITE_BASE_URL=https://api.datacite.org

# User-Agent för DataCite. Sätt en egen med kontaktuppgift.
DATACITE_USER_AGENT=Discovery-MCP/0.1 (+https://github.com/<GITHUB_KONTO>/discovery-mcp)

# Timeout i sekunder för HTTP-anrop mot DataCite.
DATACITE_TIMEOUT=30

# -----------------------------------------------------------------------------
# MCP-transport
# -----------------------------------------------------------------------------
# Transport-läge: stdio (lokal MCP-klient) eller http (delad drift).
MCP_TRANSPORT=stdio

# HTTP-transport — adress och port (används bara när MCP_TRANSPORT=http).
MCP_HOST=127.0.0.1
MCP_PORT=8000

# API-nyckel för Bearer-token-autentisering i HTTP-läget. Obligatorisk —
# uppstart i http-läge avbryts (exitkod 2) om nyckeln saknas.
# Generera med: python3 -c "import secrets; print(secrets.token_hex(32))"
MCP_API_KEY=
