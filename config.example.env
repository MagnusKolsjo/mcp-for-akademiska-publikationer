# =============================================================================
# MCP-server för discovery — sök publikationer och deras metadata
# Konfigurationsmall — kopiera till .env och fyll i värden
# .env ska aldrig checkas in i git
# =============================================================================

# -----------------------------------------------------------------------------
# Libris-API (KB:s nationella bibliotekskatalog)
# -----------------------------------------------------------------------------
# Bas-URL för Libris sök- och läs-API. Behöver normalt inte ändras.
LIBRIS_BASE_URL=https://libris.kb.se

# Bas-URL för id.kb.se — KB:s länkade auktoritetsdata (ämnen, personer, språk).
# Används av termuppslaget. Behöver normalt inte ändras.
LIBRIS_ID_BASE_URL=https://id.kb.se

# User-Agent. Libris uppmanar uttryckligen anropare att identifiera sig så att
# KB kan kontakta dig vid problem. Sätt en egen med kontaktuppgift.
LIBRIS_USER_AGENT=Discovery-MCP/0.1 (+https://github.com/<GITHUB_KONTO>/discovery-mcp)

# Timeout i sekunder för HTTP-anrop mot Libris.
LIBRIS_TIMEOUT=30

# -----------------------------------------------------------------------------
# Crossref-API (DOI:er för artiklar, böcker, konferensbidrag)
# -----------------------------------------------------------------------------
# Bas-URL för Crossref REST-API. Behöver normalt inte ändras.
CROSSREF_BASE_URL=https://api.crossref.org

# Kontakt-e-post som lägger anropen i Crossrefs "polite pool" med bättre
# svarstider. Frivilligt men rekommenderas. Lämna tom för anonyma anrop.
CROSSREF_MAILTO=

# User-Agent för Crossref. Kontakt-e-posten ovan bakas in automatiskt.
CROSSREF_USER_AGENT=Discovery-MCP/0.1 (+https://github.com/<GITHUB_KONTO>/discovery-mcp)

# Timeout i sekunder för HTTP-anrop mot Crossref.
CROSSREF_TIMEOUT=30

# -----------------------------------------------------------------------------
# DataCite-API (DOI:er för forskningsdata, programvara, preprints)
# -----------------------------------------------------------------------------
# Bas-URL för DataCite REST-API. Behöver normalt inte ändras.
DATACITE_BASE_URL=https://api.datacite.org

# User-Agent för DataCite. Sätt en egen med kontaktuppgift.
DATACITE_USER_AGENT=Discovery-MCP/0.1 (+https://github.com/<GITHUB_KONTO>/discovery-mcp)

# Timeout i sekunder för HTTP-anrop mot DataCite.
DATACITE_TIMEOUT=30

# -----------------------------------------------------------------------------
# arXiv-API (preprints inom fysik, matematik, datavetenskap m.fl.)
# -----------------------------------------------------------------------------
# Bas-URL för arXivs Atom-API. Behöver normalt inte ändras.
ARXIV_BASE_URL=https://export.arxiv.org/api/query

# User-Agent för arXiv. Sätt en egen med kontaktuppgift.
ARXIV_USER_AGENT=Discovery-MCP/0.1 (+https://github.com/<GITHUB_KONTO>/discovery-mcp)

# Timeout i sekunder för HTTP-anrop mot arXiv.
ARXIV_TIMEOUT=30

# -----------------------------------------------------------------------------
# Gemensamt för discovery-källorna — se README:s källtabell.
# -----------------------------------------------------------------------------
# Kontakt-e-post. Krävs av Unpaywall (varje anrop avvisas annars — källan
# stängs då av automatiskt, se discovery_kallor). Höjer även OpenAlex
# artighetspool och bakas in i NVA:s User-Agent. Skriv din egen adress, inte
# ett exempel eller en platshållare — flera källor avvisar uttryckligen
# testadresser.
DISCOVERY_KONTAKT_EPOST=

# Standard-User-Agent för nya källor utan egen *_USER_AGENT ovan (arXiv m.fl.
# har kvar sin egna, liksom DiVA — se diva_client.py för varför). Behöver
# normalt inte ändras.
DISCOVERY_USER_AGENT=Discovery-MCP/0.1 (+https://github.com/<GITHUB_KONTO>/discovery-mcp)

# Av/på-läge per källa. Alla källor är "true" som standard utom CORE (se
# nedan) och sådana som kräver en nyckel/e-post de saknar (inaktiveras
# automatiskt). Sätt till false för att stänga av en källa du inte vill fråga.
# För Libris, Crossref, DataCite och arXiv tas då även källans egna verktyg
# (libris_*, cr_*, dc_*, arxiv_*) bort ur verktygslistan.
DISCOVERY_LIBRIS_AKTIV=true
DISCOVERY_CROSSREF_AKTIV=true
DISCOVERY_DATACITE_AKTIV=true
DISCOVERY_ARXIV_AKTIV=true
DISCOVERY_OPENALEX_AKTIV=true
DISCOVERY_UNPAYWALL_AKTIV=true
DISCOVERY_SEMANTICSCHOLAR_AKTIV=true
DISCOVERY_SWEPUB_AKTIV=true
DISCOVERY_DIVA_AKTIV=true
DISCOVERY_PUBLICERA_AKTIV=true
DISCOVERY_NVA_AKTIV=true
DISCOVERY_OSF_AKTIV=true
DISCOVERY_EUROPEPMC_AKTIV=true
DISCOVERY_ZBMATH_AKTIV=true
DISCOVERY_ECONBIZ_AKTIV=true
DISCOVERY_HAL_AKTIV=true

# DOAJ, av samma skäl som ovan, men nämnt separat eftersom det är den sista
# av de fritt tillgängliga källorna utan nyckel eller kontaktkrav.
DISCOVERY_DOAJ_AKTIV=true

# CORE — av som standard (se core_client.py). Sätt till true för att slå på.
DISCOVERY_CORE_AKTIV=false

# API-nycklar — samtliga valfria. OpenAlex: höjer det dagliga kostnadstaket
# (gratis nyckel: registrera på openalex.org). Semantic Scholar: ger en
# egen, stabilare kvot i stället för den hårt begränsade delade poolen
# (ansök på semanticscholar.org/product/api). OSF: ett Personal Access
# Token höjer REST-API:ets kvot från 100/timme för hämtning av enskilda
# poster; sökningen går via SHARE och berörs inte (osf.io/settings/tokens).
# CORE: gratis registrering ger en högre kvot än ~5 sökningar/10 sekunder
# (registrera på core.ac.uk/services/api).
DISCOVERY_OPENALEX_API_NYCKEL=
DISCOVERY_SEMANTICSCHOLAR_API_NYCKEL=
DISCOVERY_OSF_API_NYCKEL=
DISCOVERY_CORE_API_NYCKEL=

# En källa som svarar 429 (för många anrop) eller missar tidsgränsen två
# gånger i rad pausas så här många sekunder i discovery_sok, så att den
# inte fördröjer varje svar medan den är överbelastad.
DISCOVERY_PAUS_VID_OVERBELASTNING_S=300

# Varje ny källa har dessutom egna, valfria <KALLA>_BASE_URL/_USER_AGENT/
# _TIMEOUT-variabler (t.ex. DIVA_USER_AGENT, NVA_TIMEOUT) för att byta
# bas-adress, sätta en egen User-Agent eller ändra tidsgräns för just den
# källan — se respektive <kalla>_client.py. Behövs normalt inte.

# -----------------------------------------------------------------------------
# Databas och svarscache
# -----------------------------------------------------------------------------
# Svarscachen sparar källornas svar en kort tid så att upprepade anrop inte
# kostar nya API-anrop. Den kräver en databas; välj ett av alternativen.
# Utan DATABASE_URL frågas källorna direkt varje gång.
#
# PostgreSQL: tabellen hamnar i schemat "discovery", så databasen kan delas
# med andra MCP-servrar. Kräver paketet psycopg2-binary.
# DATABASE_URL=postgresql://<ANVÄNDARE>:<LÖSENORD>@localhost:5432/<DATABASNAMN>
#
# SQLite: en lokal fil, relativ till servermappen. Ingen serverprocess.
# DATABASE_URL=sqlite:///discovery-cache.db

# Slå av svarscachen utan att ta bort DATABASE_URL.
DISCOVERY_CACHE_AKTIV=true

# Livstid för sökningar (timmar) och enskilda poster (dagar). Utgångna
# svar raderas — det här är en tillfällig cache, inte ett arkiv.
DISCOVERY_CACHE_SOK_TIMMAR=6
DISCOVERY_CACHE_POST_DAGAR=7

# -----------------------------------------------------------------------------
# Arbetsbibliotek (kräver DATABASE_URL och paketen i requirements-bibliotek.txt)
# -----------------------------------------------------------------------------
# Sparade publikationer med abstract, referens och fulltext i numrerade
# stycken, sökbara med ord och betydelse. false ger en lättviktig Discovery
# utan biblioteksverktyg; PDF- och embeddingpaketen laddas då aldrig.
DISCOVERY_BIBLIOTEK_AKTIV=true

# Semantisk sökning i biblioteket (embeddings). false ger bara ordsökning
# och ingen embeddingmodell. Kräver pgvector i Postgres eller sqlite-vec.
DISCOVERY_BIBLIOTEK_SEMANTISK=true

# Flerspråkig modell eftersom biblioteket blandar språk; den måste ha 768
# dimensioner (vektortabellens storlek). Byts modellen måste sparade poster
# sparas om för att deras vektorer ska stämma.
DISCOVERY_EMBEDDING_MODELL=intfloat/multilingual-e5-base

# Styckesindelning av fulltexten (tecken).
# DISCOVERY_STYCKE_MAX_TECKEN=800
# DISCOVERY_STYCKE_MIN_TECKEN=100
# DISCOVERY_STYCKE_OVERLAPP_TECKEN=200

# Hämtning av fulltext: tidsgräns (s) och största fil (MB).
# DISCOVERY_FULLTEXT_TIMEOUT=60
# DISCOVERY_FULLTEXT_MAX_MB=40

# -----------------------------------------------------------------------------
# Begreppsexpansion (frivillig)
# -----------------------------------------------------------------------------
# Servern kan själv ta fram en fråga på flera språk, med synonymer, via en
# språkmodell med OpenAI-kompatibelt API. Avstängd tar den anropande
# assistenten fram varianterna i stället (skillen sok-vetenskapligt) och
# skickar q per språk till discovery_sok.
DISCOVERY_BEGREPPSEXPANSION_AKTIV=false

# Exempel Ollama: http://localhost:11434/v1
# Exempel OpenAI: https://api.openai.com/v1
DISCOVERY_BEGREPPSEXPANSION_URL=
DISCOVERY_BEGREPPSEXPANSION_MODELL=
DISCOVERY_BEGREPPSEXPANSION_API_NYCKEL=

# Promptfilen går att redigera utan kodändring (relativ till servermappen).
# DISCOVERY_BEGREPPSEXPANSION_PROMPTFIL=prompts/begreppsexpansion.txt
# DISCOVERY_BEGREPPSEXPANSION_TIMEOUT=20

# -----------------------------------------------------------------------------
# MCP-transport
# -----------------------------------------------------------------------------
# Transport-läge: stdio (lokal MCP-klient) eller http (delad drift).
MCP_TRANSPORT=stdio

# HTTP-transport — adress och port (används bara när MCP_TRANSPORT=http).
MCP_HOST=127.0.0.1
MCP_PORT=8000

# API-nyckel för Bearer-token-autentisering i HTTP-läget. Obligatorisk —
# uppstart i http-läge avbryts (exitkod 2) om nyckeln saknas.
# Generera med: python3 -c "import secrets; print(secrets.token_hex(32))"
MCP_API_KEY=
